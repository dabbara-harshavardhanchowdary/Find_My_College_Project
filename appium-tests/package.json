{
  "name": "find-my-college-appium-mobile-e2e-tests",
  "version": "1.0.0",
  "description": "Comprehensive Appium 2.x / UiAutomator2 Mobile E2E Automation Test Suite for Find My College Android Native Application (Jetpack Compose)",
  "main": "app-tests.js",
  "scripts": {
    "test": "node app-tests.js",
    "test:android": "cross-env PLATFORM=android node app-tests.js",
    "test:emulator": "cross-env DEVICE_NAME=\"Pixel_7_API_34\" node app-tests.js",
    "test:device": "cross-env DEVICE_TYPE=real node app-tests.js",
    "test:mocha": "mocha tests/app-tests.js --timeout 120000 --exit",
    "generate-report": "python generate_excel.py"
  },
  "keywords": [
    "appium",
    "uiautomator2",
    "android",
    "jetpack-compose",
    "mobile-automation",
    "e2e-testing",
    "find-my-college"
  ],
  "author": "Find My College QA Mobile Automation Engineering Team",
  "license": "ISC",
  "devDependencies": {
    "appium": "^2.5.1",
    "chai": "^4.3.10",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.5",
    "mocha": "^10.4.0",
    "webdriverio": "^8.36.0"
  }
}
